# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.

# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> pooled connection string.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# DeepSeek API key, from https://platform.deepseek.com
# Only needed for two things: the "Bakit?" reasoning text, and the fallback PDF
# reader that runs when the DA changes its document layout. The daily price
# extraction itself is pure code (lib/da-parser.ts) and needs no API key.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Shared secret protecting the /api/cron/* routes. Any long random string.
# On Vercel this must be set for BOTH Production and Preview, or the daily
# cron job cannot authenticate against its own endpoints.
CRON_SECRET=pick-a-long-random-string
